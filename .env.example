# Copy to client/.env. Vite loads this file when the client starts.

# Client dev server.
PORT=4178

# API origin. The browser calls ${VITE_API_URL}/api/...
# Must match the server PORT, and the server CLIENT_ORIGIN must match this app.
VITE_API_URL=http://127.0.0.1:4179

# Google OAuth 2.0 Web client ID (Google Identity Services). Must match server GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# Optional Mintlify workspace fallbacks when no working/draft URL is set on a record.
VITE_MINTLIFY_FALLBACK_PRODUCT_GUIDES=https://app.mintlify.com/koinx-e9affad9/koinx-e9affad9/~/7a086ed0-2ec0-4e83-b1d2-f8757cbff368
VITE_MINTLIFY_FALLBACK_INTEGRATION_STEPS=https://app.mintlify.com/koinx-e9affad9/koinx-e9affad9/~/62111361-3e48-4da7-9aea-01a9625ec8f9
